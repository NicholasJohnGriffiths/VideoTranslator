{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"VideoTranslation.slnx"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "run-local",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"VideoTranslator",
				"--launch-profile",
				"http",
				"--no-build"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}