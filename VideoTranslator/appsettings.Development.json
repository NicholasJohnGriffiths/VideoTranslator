{
  "DetailedErrors": true,
  "AzureHosting": {
    "ProcessingEnabled": false
  },
  "AzureOpenAI": {
    "Enabled": false,
    "CredentialMode": "AzureCli"
  },
  "AzureSpeech": {
    "Enabled": true,
    "SynthesisEnabled": true,
    "CredentialMode": "AzureCli"
  },
  "Media": {
    "FFmpegPath": "%LOCALAPPDATA%\\Microsoft\\WinGet\\Links\\ffmpeg.exe",
    "FFprobePath": "%LOCALAPPDATA%\\Microsoft\\WinGet\\Links\\ffprobe.exe"
  },
  "JobStorage": {
    "Provider": "AzureBlob"
  },
  "BlobStorage": {
    "CredentialMode": "AzureCli"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
