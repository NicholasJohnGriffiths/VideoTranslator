@page "/jobs/{jobId}"
@model VideoTranslator.Pages.JobModel
@using VideoTranslator.Models
@{
    ViewData["Title"] = "Video job";
    var finalStage = Model.Job.Status is JobStatus.CreatingSubtitles or JobStatus.RenderingVideo or JobStatus.Completed;
    var failedFinalStage = Model.Job.Status == JobStatus.Failed
        && Model.Job.FailedAtStatus is JobStatus.CreatingSubtitles or JobStatus.RenderingVideo;
    var translationEnabled = OpenAIConfiguration.Value.Enabled;
}

<div class="page-heading">
    <span class="eyebrow">YOUR VIDEO JOB</span>
    <h1>@(Model.Job.Status switch
        {
            JobStatus.AudioReady => "Audio ready.",
            JobStatus.Transcribing => "Transcribing English.",
            JobStatus.TranscriptReady => "English transcript ready.",
            JobStatus.Translating => "Translating your script.",
            JobStatus.AwaitingScriptReview => "Your translation is ready to review.",
            JobStatus.GeneratingSpeech => "Generating translated audio.",
            JobStatus.TranslatedAudioReady => "Translated audio ready.",
            JobStatus.CreatingSubtitles => "Creating subtitles.",
            JobStatus.RenderingVideo => "Rendering your video.",
            JobStatus.Completed => "Translation complete.",
            JobStatus.ExtractingAudio => "Extracting audio.",
            JobStatus.Failed => "Processing failed.",
            _ => "Upload saved."
        })</h1>
    <p class="lead">Your video and selected language have been saved
        @(StorageConfiguration.Value.IsLocal ? "on this machine" : "in a private Azure Blob container").</p>
</div>
<p><a asp-page="/MyVideos">Back to my videos</a></p>
<partial name="_JobNextStep" model="Model.Job" />
<section class="surface">
    <div class="job-title">
        <h2>@Model.Job.OriginalFileName</h2>
        <span class="status-badge">@Model.Job.Status</span>
    </div>
    <dl class="job-details">
        <dt>Job ID</dt>
        <dd><code>@Model.Job.JobId</code></dd>
        <dt>Target language</dt>
        <dd>@(Model.Language?.DisplayName ?? Model.Job.SelectedLanguage)</dd>
        <dt>Video size</dt>
        <dd>@((Model.Job.FileSizeBytes / 1024d / 1024d).ToString("0.00")) MB</dd>
        <dt>Created (UTC)</dt>
        <dd><time datetime="@Model.Job.CreatedUtc.ToString("O")">@Model.Job.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss")</time></dd>
    </dl>
    <partial name="_JobCost" model="Model.Job" />
    <ol class="job-steps">
        @foreach (var stage in JobStageProgress.For(Model.Job, SpeechConfiguration.Value.Enabled,
            translationEnabled, SpeechConfiguration.Value.SynthesisEnabled))
        {
            <li class="@(stage.State == StageProgressState.Complete ? "done" : "")">
                <strong>@stage.Title</strong>
                <div class="job-stage-indicator">
                    <span>@stage.Description</span>
                    <div class="job-stage-progress @stage.CssClass" role="progressbar"
                         aria-label="@stage.Title" aria-valuemin="0" aria-valuemax="100"
                         aria-valuenow="@stage.Value" aria-valuetext="@stage.Description">
                        <div class="job-stage-progress-fill"></div>
                    </div>
                </div>
            </li>
        }
    </ol>
    <p class="small mt-3 mb-0">Animated bars indicate processing, not a measured percentage.
        Stages update automatically while processing; review and rendering approval require your confirmation.</p>
</section>
<aside class="notice">
    @if (Model.Job.Status == JobStatus.Failed)
    {
        <strong>Processing failed.</strong>
        <span>@Model.Job.ErrorMessage</span>
    }
    else if (Model.Job.Status == JobStatus.TranscriptReady)
    {
        <strong>English transcript complete.</strong>
        <span>Time-coded English segments are saved with this job.
            @(OpenAIConfiguration.Value.Enabled ? "Private OpenAI translation is queued; usage charges apply."
                : "Live OpenAI translation is disabled until private routing and identity permissions are verified. No public fallback is permitted.")</span>
    }
    else if (Model.Job.Status == JobStatus.Translating)
    {
        <strong>Translation @(translationEnabled ? "in progress." : "paused.")</strong>
        <span>@(translationEnabled ? "The English transcript is being translated through the approved private endpoint in Australia East. OpenAI usage charges apply."
            : "Live translation is disabled. Verify private routing before enabling it.")</span>
    }
    else if (Model.Job.Status == JobStatus.AwaitingScriptReview)
    {
        <strong>Review your translated script.</strong>
        <span>Edit or reset individual segments. Saving preserves the original English, timestamps and machine translation.</span>
        @if (Model.Job.ReviewMessage is not null)
        {
            <p role="alert"><strong>Audio generation returned to review.</strong> @Model.Job.ReviewMessage
                Open the script review page to check the segment and approve using the current speed limit.
                Reapproving unchanged wording will repeat the problem if it still cannot fit.</p>
        }
    }
    else if (Model.Job.Status == JobStatus.GeneratingSpeech)
    {
        <strong>Full audio @(SpeechConfiguration.Value.SynthesisEnabled ? "generation queued or running." : "generation paused.")</strong>
        <span>Generation uses the approved saved script and configured voice. New synthesis is billable.
            @if (Model.Job.ApprovedSpeech?.UseAvailableGaps == true)
            {
                <span>Speech may continue until the next segment starts, or to the video end for the last segment.</span>
            }
            Speech is fitted up to @(Model.Job.ApprovedSpeech?.MaximumSpeed.ToString("0.00"))x speed;
            timing issues return the job to review without cutting words off.</span>
    }
    else if (Model.Job.Status == JobStatus.TranslatedAudioReady)
    {
        <strong>Your translated voice track is ready.</strong>
        <span>Listen to the track, then explicitly confirm rendering to replace the original audio and include switchable subtitles.</span>
    }
    else if (Model.Job.Status is JobStatus.CreatingSubtitles or JobStatus.RenderingVideo)
    {
        <strong>Final output queued or processing.</strong>
        <span>The frozen approved script supplies subtitles and the completed track replaces the original audio.
            No new AI requests are made. Rendering uses server CPU, temporary disk and private storage.
            This page refreshes automatically.</span>
    }
    else if (Model.Job.Status == JobStatus.Completed)
    {
        <strong>Your translated video is ready.</strong>
        <span>Play or download the MP4, switch subtitles on or off, and download the approved script and UTF-8 WebVTT.</span>
    }
    else if (Model.Job.Status == JobStatus.Transcribing)
    {
        <strong>Recognising English speech.</strong>
        <span>Extracted audio is being sent to Azure Speech in Australia East.
            This page refreshes automatically. Speech usage charges apply.</span>
    }
    else if (Model.Job.Status == JobStatus.AudioReady && !SpeechConfiguration.Value.Enabled)
    {
        <strong>Audio extraction complete.</strong>
        <span>Mono 16 kHz PCM WAV audio is saved with this job. Speech transcription is disabled in configuration.</span>
    }
    else
    {
        <strong>Queued for background processing.</strong>
        <span>One job runs at a time. This page refreshes automatically while processing is pending.
            Storage failures are logged and pending jobs are retried; prolonged waiting may require administrator attention.</span>
    }
    You can bookmark this page; job details survive application restarts
    @(StorageConfiguration.Value.IsLocal ? "on the same machine" : "when using the same Azure container").
</aside>
<a asp-page="/Upload" class="btn btn-outline-primary">Upload another video</a>
@if (finalStage || failedFinalStage || Model.Job.Status is JobStatus.TranscriptReady or JobStatus.Translating or JobStatus.AwaitingScriptReview or JobStatus.GeneratingSpeech or JobStatus.TranslatedAudioReady
    || (Model.Job.Status == JobStatus.Failed && Model.Job.FailedAtStatus is JobStatus.Translating or JobStatus.GeneratingSpeech))
{
    <a asp-page="/Transcript" asp-route-jobId="@Model.Job.JobId" class="btn btn-primary">View English transcript</a>
}
@if (Model.Job.Status == JobStatus.AwaitingScriptReview)
{
    <a asp-page="/Script" asp-route-jobId="@Model.Job.JobId" class="btn btn-primary">Review &amp; edit script</a>
}
@if (finalStage || Model.Job.Status == JobStatus.TranslatedAudioReady)
{
    <a asp-page="/TranslatedAudio" asp-route-jobId="@Model.Job.JobId" class="btn btn-primary">Listen &amp; download translated audio</a>
}
@if (finalStage || failedFinalStage || Model.Job.Status is JobStatus.GeneratingSpeech or JobStatus.TranslatedAudioReady)
{
    <a asp-page="/Script" asp-route-jobId="@Model.Job.JobId" class="btn btn-outline-primary">View approved script</a>
}
@if (Model.Job.Status == JobStatus.Completed)
{
    <a asp-page="/Result" asp-route-jobId="@Model.Job.JobId" class="btn btn-primary">Play &amp; download video</a>
}
@if (Model.Job.Status is JobStatus.Uploaded or JobStatus.ExtractingAudio or JobStatus.Transcribing
    || (Model.Job.Status == JobStatus.AudioReady && SpeechConfiguration.Value.Enabled)
    || (Model.Job.Status is JobStatus.TranscriptReady or JobStatus.Translating && translationEnabled)
    || (Model.Job.Status == JobStatus.GeneratingSpeech && SpeechConfiguration.Value.SynthesisEnabled)
    || Model.Job.Status is JobStatus.CreatingSubtitles or JobStatus.RenderingVideo)
{
    @section Scripts {
        <script src="~/js/job.js" asp-append-version="true"></script>
    }
}
