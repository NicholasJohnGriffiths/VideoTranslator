@page "/jobs/{jobId}/audio"
@model VideoTranslator.Pages.TranslatedAudioModel
@using VideoTranslator.Models
@{
    ViewData["Title"] = "Translated audio";
}
<div class="page-heading">
    <span class="eyebrow">TRANSLATED AUDIO</span>
    <h1>Your timed voice track.</h1>
    <p class="lead">@Model.Job.OriginalFileName / @Model.Result.DurationSeconds.ToString("0.00") seconds</p>
</div>
@if (Model.Job.Status == JobStatus.TranslatedAudioReady)
{
    <aside class="next-step" aria-label="Next step">
        <h2>Next step: listen, then render</h2>
        <p>Play the voice track below. If it sounds right, <a href="#render-video">tick the replacement checkbox</a>
            and choose <strong>Render final video</strong>. Listening alone does not start rendering.</p>
        <p>The finished video will include the translated audio and switchable subtitles.</p>
    </aside>
}
else
{
    <partial name="_JobNextStep" model="Model.Job" />
}
<section class="surface">
    <p>The approved script has been synthesized from its original segment starts.
        @if (Model.Job.ApprovedSpeech!.UseAvailableGaps)
        {
            <span>Speech may use the following gap, but never overlap the next segment or extend past the video end.</span>
        }
        else
        {
            <span>Speech remains within the original segment ends.</span>
        }
        Remaining time is padded with silence. This is the audio track, not a rendered video.</p>
    <audio controls preload="none" aria-label="Full translated voice track">
        <source src="@Url.Page("/TranslatedAudio", "File", new { jobId = Model.Job.JobId })" type="audio/wav" />
    </audio>
    <p data-audio-error hidden role="alert">The audio track could not be loaded. Check your connection or contact the administrator.</p>
    <a class="btn btn-primary mt-3" asp-page-handler="Download" asp-route-jobId="@Model.Job.JobId">Download translated WAV</a>
    <div class="table-responsive mt-3">
        <table class="table">
            <thead><tr><th>Segment</th><th>Generated speech</th><th>Available window</th><th>Speed</th></tr></thead>
            <tbody>
                @foreach (var timing in Model.Result.Segments)
                {
                    <tr><td>@timing.Sequence</td><td>@timing.SourceSeconds.ToString("0.00") s</td>
                        <td>@timing.SlotSeconds.ToString("0.00") s</td><td>@timing.Speed.ToString("0.000")x</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Job.Status == JobStatus.TranslatedAudioReady)
    {
        <form id="render-video" method="post" asp-page-handler="Render" asp-route-jobId="@Model.Job.JobId" class="mt-3">
            <div class="form-check">
                <input type="checkbox" name="confirmRendering" value="true" id="confirmRendering" class="form-check-input" />
                <label for="confirmRendering" class="form-check-label">Replace the original audio with this translated track and render the final video.</label>
            </div>
            <p>Uses the frozen approved script. Includes switchable subtitles and a separate UTF-8 WebVTT download.
                No new Speech or OpenAI requests. Rendering uses server CPU, disk and storage; no burned-in subtitles.</p>
            <button type="submit" class="btn btn-primary">Render final video</button>
        </form>
    }
    @if (Model.Job.Status == JobStatus.Completed)
    {
        <a asp-page="/Result" asp-route-jobId="@Model.Job.JobId" class="btn btn-primary mt-3">View final video</a>
    }
</section>
<a class="btn btn-outline-primary mt-3" asp-page="/Job" asp-route-jobId="@Model.Job.JobId">Back to job</a>
<a class="btn btn-outline-primary mt-3" asp-page="/Script" asp-route-jobId="@Model.Job.JobId">View approved script</a>
@section Scripts {
    <script src="~/js/translated-audio.js" asp-append-version="true"></script>
}
